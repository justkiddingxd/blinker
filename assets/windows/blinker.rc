// Windows resources of blinker.exe: the icon (Explorer, the taskbar, Start)
// and the version info (the name Windows search and Task Manager show).
#include <winver.h>

1 ICON "blinker.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     BK_MAJOR,BK_MINOR,BK_PATCH,0
PRODUCTVERSION  BK_MAJOR,BK_MINOR,BK_PATCH,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "blinker"
            VALUE "FileDescription",  "blinker"
            VALUE "ProductName",      "blinker"
            VALUE "InternalName",     "blinker"
            VALUE "OriginalFilename", "blinker.exe"
            VALUE "FileVersion",      BK_VERSION
            VALUE "ProductVersion",   BK_VERSION
            VALUE "LegalCopyright",   "GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
